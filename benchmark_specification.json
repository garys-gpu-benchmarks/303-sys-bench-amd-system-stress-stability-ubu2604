  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Analyze thermal and power samples under CPU stress-ng"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates per-second telemetry during yaml duration. GPU GEMM load is not applied"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Peak GPU junction temperature (peak_gpu_junction_temp_c); #2: Sustained GPU power (sustained_gpu_power_w); #3: GPU ECC error count (gpu_system_ecc_error_count); #4: Thermal throttle events (thermal_throttle_event_count)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run stress-ng --cpu, rocm-smi and/or amd-smi metric, and sysfs power1_average"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run stress-ng --cpu <num_threads> --cpu-load <cpu_load_percent> --timeout <duration>s while polling rocm-smi/amd-smi each second, to measure peak CPU/GPU temperature and GPU power over the wall-clock window. No rocblas-bench GPU load is started"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run stress-ng --cpu for yaml duration and cpu_load_percent, and sample GPU utilization, temperature, and power from rocm-smi, amd-smi, and sysfs once per second. No rocblas-bench GPU load is started"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Runs CPU-only stress-ng while polling rocm-smi/amd-smi once per second. num_threads: stress-ng --cpu workers (16). cpu_load_percent: stress-ng --cpu-load (50). duration: smoke 5 / baseline 200 / extended 580 s. gpu_load_percent, temp_threshold, power_threshold, throttle_check, and ecc_check are yaml fields and are ignored; no rocblas-bench or GPU GEMM load is started. output_format: csv"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "System Validation & Reliability"
  },
  {
    "field_name": "Workload Type",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Test"
  },
  {
    "field_name": "Target Hardware",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CPU"
  },
  {
    "field_name": "GPU Model",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "MI300X"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV with one time-series row per elapsed second"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one CSV row per polling second during duration"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,second,gpu_util_pct,gpu_temp_c,gpu_power_w,ecc_uncorrected,peak_gpu_junction_temp_c,sustained_gpu_power_w,thermal_throttle_event_count,gpu_system_ecc_error_count\n0,0,0,45,75,0,45,75,0,0"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --num-threads 16 --cpu-load-percent 50 --gpu-load-percent 50 --temp-threshold 75 --power-threshold 500 --throttle-check true --ecc-check true --duration 5 --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --num-threads 16 --cpu-load-percent 50 --gpu-load-percent 50 --temp-threshold 75 --power-threshold 500 --throttle-check true --ecc-check true --duration 200 --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --num-threads 16 --cpu-load-percent 50 --gpu-load-percent 50 --temp-threshold 75 --power-threshold 500 --throttle-check true --ecc-check true --duration 580 --output-format csv"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "gpu_util_pct, gpu_temp_c, gpu_power_w, ecc_uncorrected, peak_gpu_junction_temp_c, sustained_gpu_power_w, thermal_throttle_event_count, gpu_system_ecc_error_count"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "One sample per elapsed second parses, and validation accepts the configured GPU temperature, power, throttle, and ECC gates"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "The CSV has no CPU utilization or CPU temperature columns. gpu_system_ecc_error_count is the uncorrectable delta from the last sample minus the first, copied onto every row. A RAS table that names the columns and yields no counts is na (RAS table not parsed)"
  },
